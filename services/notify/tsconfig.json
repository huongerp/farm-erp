{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2023"],
    "types": ["node"],
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    // Cho phép viết `import './db.ts'` rồi tsc tự đổi thành .js khi emit, nhờ đó
    // cùng một mã nguồn chạy được cả với `node --experimental-strip-types` lúc dev.
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "sourceMap": true
  },
  "include": ["src"],
  // Test chạy bằng vitest ở repo gốc (không có trong package.json của service này),
  // nên bước build bằng tsc phải bỏ qua — image Docker chỉ COPY thư mục này.
  "exclude": ["src/**/*.test.ts"]
}
