# Supabase (lấy từ Dashboard → Settings → API)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-key
## Service Role Key — CHỈ dùng trên Supabase Edge Function, KHÔNG expose ra frontend
## SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Cloudinary — BẮT BUỘC để tránh lưu ảnh base64 vào DB (egress lớn)
# Dashboard → Settings → API Keys; CLOUDINARY_URL chỉ dùng script migrate (server-side)
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
VITE_CLOUDINARY_CLOUD_NAME=your-cloud-name
# Upload preset Unsigned: Dashboard → Upload → Add upload preset
VITE_CLOUDINARY_UPLOAD_PRESET=fp-farm

# Dev: đếm request Supabase theo bảng/giây (xem docs/EGRESS_OPTIMIZATION.md)
# VITE_SUPABASE_REQUEST_LOGGER=1

# Script migrate-base64-to-cloudinary.mjs (service role — không commit .env thật)
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
