# =====================================================================
# Frontend (Vite) — nhúng vào bundle lúc build, KHÔNG đặt secret ở đây
# =====================================================================

# Để trống — cả production (Traefik) lẫn dev (proxy trong vite.config.ts) đều
# route /api và /auth giúp. Chỉ khai khi cần trỏ thẳng ra host khác (vd `vite
# preview` nhắm vào API đã deploy trên VPS).
# VITE_API_URL=https://erp.example.com/api
# VITE_AUTH_URL=https://erp.example.com/auth
# VITE_NOTIFY_URL=https://erp.example.com/notify
# VITE_SHEETS_URL=https://erp.example.com/sheets

# Dev only — `npm run dev` tự bật PostgREST + auth-service ở hai cổng này.
# Đổi cổng nếu bị trùng; trỏ ra host khác (vd API đã deploy trên VPS) thì plugin
# không spawn gì cả. Xem README mục "Chạy full-stack ở local".
# DEV_API_PROXY_TARGET=http://127.0.0.1:3010
# DEV_AUTH_PROXY_TARGET=http://127.0.0.1:3001
# DEV_NOTIFY_PROXY_TARGET=http://127.0.0.1:3002
# DEV_SHEETS_PROXY_TARGET=http://127.0.0.1:3003

# Đặt =1 để `npm run dev` chỉ chạy SPA, không bật hai service kèm theo.
# DEV_SKIP_SERVICES=1

# OAuth client ID (Google Cloud Console → Credentials). Luồng GIS chỉ cần
# Client ID, không cần Client Secret. Nhớ thêm domain vào Authorized
# JavaScript origins, nếu không nút Google sẽ không hiện.
VITE_GOOGLE_CLIENT_ID=

# Cloudinary — BẮT BUỘC để tránh lưu ảnh base64 vào DB (egress lớn)
# Dashboard → Settings → API Keys; CLOUDINARY_URL chỉ dùng script migrate (server-side)
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
VITE_CLOUDINARY_CLOUD_NAME=your-cloud-name
# Upload preset Unsigned: Dashboard → Upload → Add upload preset
VITE_CLOUDINARY_UPLOAD_PRESET=fp-farm

# VITE_SENTRY_DSN=

# Dev: đếm request theo bảng/giây (xem docs/EGRESS_OPTIMIZATION.md)
# VITE_API_REQUEST_LOGGER=1

# =====================================================================
# Deploy trên Dokploy (docker-compose.yml)
# Khai trong tab Environment của Dokploy, KHÔNG commit giá trị thật.
# Xem runbook: docs/VPS_POSTGREST_PLAN.md
#
# ⚠ MẬT KHẨU PHẢI PERCENT-ENCODE trong connection string.
#   Ký tự @ → %40, : → %3A, / → %2F, # → %23, ? → %3F
#   Ví dụ mật khẩu `Kem@2021` phải viết `Kem%402021`, nếu không libpq sẽ
#   hiểu sai phần host (cắt tại dấu @ đầu tiên) và báo lỗi kết nối.
# =====================================================================

# Domain duy nhất của app — Traefik dùng để route cả 3 service.
# APP_DOMAIN=erp.example.com

# Client ID Google, dùng cho cả bundle SPA và phần verify ID token ở auth-service.
# GOOGLE_CLIENT_ID=

# Secret ký JWT — auth-service ký, PostgREST verify. PHẢI giống nhau ở cả hai,
# tối thiểu 32 ký tự. Sinh bằng: openssl rand -base64 48
# PGRST_JWT_SECRET=

# PostgREST kết nối bằng role `authenticator` (tạo ở docs/db-schema-baseline.sql),
# qua hostname NỘI BỘ của Dokploy — không đi ra Internet, không cần mở port.
# PGRST_DB_URI=postgresql://authenticator:<mat-khau-encode>@postgressdatabase-5fedudatabase-kj5glj:5432/fpfarm

# auth-service kết nối bằng role `auth_service` (tạo ở docs/db-schema-baseline.sql),
# role này chỉ EXECUTE được mấy RPC đăng nhập, không đọc bảng nào.
# AUTH_DATABASE_URL=postgresql://auth_service:<mat-khau-encode>@postgressdatabase-5fedudatabase-kj5glj:5432/fpfarm

# Mật khẩu hai role trên, dùng khi chạy script SQL chuẩn bị DB.
# Sinh bằng: openssl rand -base64 32
# PGRST_AUTHENTICATOR_PASSWORD=
# AUTH_SERVICE_DB_PASSWORD=

# =====================================================================
# Thông báo + Web Push (service `notify`)
# Bảng, trigger outbox, RPC: xem docs/db-schema-baseline.sql và docs/THONG_BAO_PUSH.md
# =====================================================================

# notify-service kết nối bằng role `notify_service` (script SQL đầu tiên tự tạo
# role và in mật khẩu ra NOTICE). Role này chỉ chạm được 4 bảng thông báo.
# NOTIFY_DATABASE_URL=postgresql://notify_service:<mat-khau-encode>@postgressdatabase-5fedudatabase-kj5glj:5432/fpfarm
# NOTIFY_SERVICE_DB_PASSWORD=
# Chu kỳ quét outbox (ms, mặc định 30000) và số lần gửi lại tối đa (mặc định 5).
# NOTIFY_SCAN_INTERVAL_MS=30000
# NOTIFY_MAX_RETRY=5

# Khoá VAPID cho Web Push — sinh MỘT LẦN rồi giữ nguyên:
#   npx web-push generate-vapid-keys
# Đổi khoá sẽ làm mọi thiết bị đã đăng ký ngừng nhận push và phải đăng ký lại.
# Bỏ trống cả hai thì chuông trong app vẫn chạy, chỉ tắt phần đẩy ra màn hình khoá.
# VITE_VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=

# Địa chỉ liên hệ theo chuẩn Web Push, push service dùng để báo khi có sự cố.
# VAPID_SUBJECT=mailto:admin@forpeasantz.vn

# Múi giờ tính "giờ yên lặng" (không rung push ngoài giờ làm).
# COMPANY_TZ=Asia/Ho_Chi_Minh

# =====================================================================
# Xuất / đồng bộ Google Sheet (service `sheets`) — hướng dẫn: docs/GOOGLE_SHEETS.md
# Bỏ trống cả khối thì app vẫn chạy, dialog Xuất chỉ ẩn lựa chọn Google Sheet.
# =====================================================================

# Role `sheets_service` (migration 011 tự tạo và in mật khẩu ra NOTICE).
# SHEETS_DATABASE_URL=postgresql://sheets_service:<mat-khau-encode>@postgressdatabase-5fedudatabase-kj5glj:5432/fpfarm
# SHEETS_SERVICE_DB_PASSWORD=

# OAuth client (Web) cho Google Sheet — tách khỏi GOOGLE_CLIENT_ID của nút đăng nhập.
# Dev bỏ trống ID thì dùng VITE_GOOGLE_CLIENT_ID.
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=

# Khoá mã hoá token Google trong DB — sinh MỘT LẦN: openssl rand -hex 32
# SHEETS_TOKEN_KEY=

# Google Picker (chọn file Sheet có sẵn): API key giới hạn Picker API + HTTP referrer,
# và Project number của project Google Cloud.
# VITE_GOOGLE_PICKER_API_KEY=
# VITE_GOOGLE_APP_ID=

# Worker đồng bộ tự động: production để mặc định (true). Dev dùng chung DB nên KHÔNG bật,
# trừ khi đang test đồng bộ: DEV_SHEETS_WORKER_BAT=true
# SHEETS_WORKER_BAT=true

# =====================================================================
# Kết nối thẳng Postgres trên VPS từ máy bạn
# Dev server (vite/dev-services.ts) dùng để tự bật PostgREST + auth + notify; cũng dùng
# khi chụp lại schema: pg_dump "$VPS_DB_URL" --schema-only --no-owner -n public
# =====================================================================

# VPS_DB_URL=postgresql://5fedu:<mat-khau-encode>@163.61.73.151:5432/fpfarm
