# Supabase (lấy từ Dashboard → Settings → API)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-key
## Service Role Key — CHỈ dùng trên Supabase Edge Function, KHÔNG expose ra frontend
## SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Cloudinary (Dashboard → Settings → API Keys; Secret chỉ dùng server-side)
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
VITE_CLOUDINARY_CLOUD_NAME=your-cloud-name
VITE_CLOUDINARY_API_KEY=your-api-key
# Upload preset (unsigned) cho upload ảnh từ frontend: Dashboard → Upload → Add upload preset → Signing: Unsigned, tên = giá trị bên dưới
VITE_CLOUDINARY_UPLOAD_PRESET=fp-farm
